#!/bin/bash

# Resize the focused (or given) Hyprland window to a size, or place it in a zone.
#   omasizer <width> <height> [window-address]
#   omasizer [--layout <zones-json>] --zone <x> <y> <width> <height> [window-address]
#   omasizer --move <left|right|up|down> <layouts-json> [window-address]
# A size is in logical pixels; the center and clamp settings come from OmaSizer's
# entry in ~/.config/omarchy/shell.json. A zone is a rectangle given as fractions
# (0 to 1) of the monitor's usable area, laid out with the gaps saved in settings,
# or with Hyprland's own gaps like tiling until they are saved.
#
# --layout names the zones of the layout the zone came from; the window remembers
# it until it closes or the session ends. --move takes { "layouts": [zones, ...],
# "starred": index } and moves the window to the next zone in that direction of
# the layout it remembers, or the starred one; past the last zone it stays put.
# Placed in a zone of a layout, by either, a window already in that zone and on
# the same layout swaps zones with it.

set -euo pipefail

usage() {
  echo "Usage: omasizer <width> <height> [window-address]" >&2
  echo "       omasizer [--layout <zones-json>] --zone <x> <y> <width> <height> [window-address]" >&2
  echo "       omasizer --move <left|right|up|down> <layouts-json> [window-address]" >&2
  exit 1
}

fraction='^(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)$'

# The jq shared by zones and moves: zone checks, and a zone's window frame.
geometry='
  def valid_zone: type == "array" and length == 4 and all(.[]; type == "number" and . >= 0 and . <= 1)
    and .[2] > 0 and .[3] > 0 and .[0] + .[2] <= 1.0001 and .[1] + .[3] <= 1.0001;
  def valid_layout: type == "array" and length >= 1 and length <= 16 and all(.[]; valid_zone);
  def sides: [splits(" +") | select(. != "") | tonumber] | if length == 1 then [.[0], .[0], .[0], .[0]] elif length == 2 then [.[0], .[1], .[0], .[1]] else . end;
  # The frame keeps the outer gap from the screen edges and half the inner gap on
  # each side facing another zone, as tiled windows do with gaps_out and gaps_in.
  # The border and, on floating workspaces, the titlebar are drawn outside the
  # window geometry, so both come out of it.
  def frame($zone; $bar):
    ($outer | sides) as [$gt, $gr, $gb, $gl]
    | ($inner | sides) as [$it, $ir, $ib, $il]
    | ($area[2] - $gl - $gr) as $w | ($area[3] - $gt - $gb) as $h
    | ($area[0] + $gl + $zone[0] * $w + (if $zone[0] > 0 then $il else 0 end)) as $left
    | ($area[0] + $gl + ($zone[0] + $zone[2]) * $w - (if $zone[0] + $zone[2] < 0.999 then $ir else 0 end)) as $right
    | ($area[1] + $gt + $zone[1] * $h + (if $zone[1] > 0 then $it else 0 end)) as $top
    | ($area[1] + $gt + ($zone[1] + $zone[3]) * $h - (if $zone[1] + $zone[3] < 0.999 then $ib else 0 end)) as $bottom
    | [$left + $border, $top + $border + $bar, $right - $left - 2 * $border, $bottom - $top - 2 * $border - $bar]
    | map(round) | [.[0], .[1], ([.[2], 1] | max), ([.[3], 1] | max)];
  def frame($zone): frame($zone; $bar);'

layout=""
if [[ ${1:-} == --layout ]]; then
  layout=${2:-}
  jq -en --argjson l "$layout" "$geometry \$l | valid_layout" >/dev/null 2>&1 || usage
  shift 2
  [[ ${1:-} == --zone ]] || usage
fi

if [[ ${1:-} == --move ]]; then
  mode=move
  direction=${2:-} spec=${3:-} address=${4:-}
  [[ $direction =~ ^(left|right|up|down)$ ]] || usage
  jq -en --argjson s "$spec" "$geometry"' $s | type == "object" and (.layouts | type == "array" and length >= 1 and length <= 20 and all(.[]; valid_layout))
    and (.starred | type == "number" and . == floor and . >= 0) and .starred < (.layouts | length)' >/dev/null 2>&1 || usage
elif [[ ${1:-} == --zone ]]; then
  mode=zone
  zone_x=${2:-} zone_y=${3:-} zone_w=${4:-} zone_h=${5:-} address=${6:-}
  for value in "$zone_x" "$zone_y" "$zone_w" "$zone_h"; do
    [[ $value =~ $fraction ]] || usage
  done
else
  mode=size
  width=${1:-} height=${2:-} address=${3:-}
  [[ $width =~ ^[1-9][0-9]*$ && $height =~ ^[1-9][0-9]*$ ]] || usage
fi

if [[ -n $address ]]; then
  client=$(hyprctl clients -j | jq -c --arg a "$address" 'first(.[] | select(.address == $a)) // empty')
else
  client=$(hyprctl activewindow -j | jq -c 'select(.address != null)')
fi
[[ -n $client ]] || { echo "omasizer: no window to resize" >&2; exit 1; }

shell_config=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json
read -r center clamp outer_gap inner_gap swap_zones < <(jq -r 'first(.plugins[]? | select(.id == "omasizer")) // {}
  | def gap: if type == "number" and . == floor and . >= 0 and . <= 200 then . else "-" end;
  "\(.center != false) \(.clamp != false) \(.outerGap | gap) \(.innerGap | gap) \(.swap != false)"' "$shell_config" 2>/dev/null || echo "true true - - true")

read -r address floating fullscreen monitor x y titlebar < <(jq -r '
  "\(.address) \(.floating) \(.fullscreen) \(.monitor) \(.at[0]) \(.at[1]) \(any(.tags[]?; . == "omarchy-floating-workspace" or . == "omarchy-floating-workspace*"))"' <<<"$client")
window="address:$address"

# Usable logical area of the window's monitor: rotated monitors swap axes, the bar's reserved space is excluded.
read -r area_x area_y area_w area_h < <(hyprctl monitors -j | jq -r --argjson id "$monitor" '
  first(.[] | select(.id == $id))
  | (if .transform % 2 == 1 then [.height, .width] else [.width, .height] end) as $px
  | "\(.x + .reserved[0]) \(.y + .reserved[1]) \(($px[0] / .scale | floor) - .reserved[0] - .reserved[2]) \(($px[1] / .scale | floor) - .reserved[1] - .reserved[3])"')

option_numbers() {
  hyprctl getoption "$1" -j 2>/dev/null | jq -r '(.css // .int // 0 | tostring)' || echo 0
}

frame_args=(
  --argjson area "[$area_x, $area_y, $area_w, $area_h]"
  --arg outer "$([[ $outer_gap != - ]] && echo "$outer_gap" || option_numbers general:gaps_out)"
  --arg inner "$([[ $inner_gap != - ]] && jq -n "$inner_gap / 2" || option_numbers general:gaps_in)"
  --argjson border "$(option_numbers general:border_size)"
  --argjson bar_height "$(option_numbers plugin:hyprbars:bar_height)"
)
frame_args+=(--argjson bar "$([[ $titlebar == true ]] && echo "${frame_args[-1]}" || echo 0)")

# Which layout each window was last placed in: window address to that layout's zones.
memory=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/omasizer-layouts.json

if [[ $mode == move ]]; then
  remembered=$(jq -c --arg a "$address" '.[$a] // null' "$memory" 2>/dev/null) || remembered=null

  # The window's layout: the one it remembers if that still exists, else the starred one.
  # Its zone is the one whose frame it fills; otherwise it is free and its own box counts.
  # The next zone lies beyond it in the direction and overlaps it across; the nearest wins.
  target=$(jq -rn "${frame_args[@]}" --argjson spec "$spec" --argjson remembered "${remembered:-null}" \
    --argjson window "$(jq -c '[.at[0], .at[1], .size[0], .size[1]]' <<<"$client")" --arg dir "$direction" "$geometry"'
    def center($i): .[$i] + .[$i + 2] / 2;
    def overlap($a; $b; $i): ([$a[$i] + $a[$i + 2], $b[$i] + $b[$i + 2]] | min) - ([$a[$i], $b[$i]] | max);
    (if $remembered != null and any($spec.layouts[]; . == $remembered) then $remembered else $spec.layouts[$spec.starred] end) as $zones
    | (first(range($zones | length) as $i | select([frame($zones[$i]), $window] | transpose | all(.[0] - .[1] | fabs <= 2)) | $i) // null) as $current
    | (if $current != null then $zones[$current]
       else [($window[0] - $area[0]) / $area[2], ($window[1] - $area[1]) / $area[3], $window[2] / $area[2], $window[3] / $area[3]] end) as $from
    | (if $dir == "left" or $dir == "right" then 0 else 1 end) as $axis
    | (if $dir == "right" or $dir == "down" then 1 else -1 end) as $sign
    | [range($zones | length) | select(. != $current) | $zones[.] as $z
       | (($z | center($axis)) - ($from | center($axis))) * $sign as $ahead
       | select($ahead > 0.001 and overlap($z; $from; 1 - $axis) > 0.001)
       | { zone: $z, rank: [$ahead, (($z | center(1 - $axis)) - ($from | center(1 - $axis)) | fabs)] }]
    | (min_by(.rank) // empty) as $next
    | "\($next.zone | map(tostring) | join(" "))\n\($zones | tojson)"')
  [[ -n $target ]] || exit 0
  { read -r zone_x zone_y zone_w zone_h; read -r layout; } <<<"$target"
  mode=zone
fi

# Placed in a zone of a layout from another zone of it: a window on the same layout
# that fills the new zone takes the one this window leaves, unless swapping is off. It moves first, so focus
# ends on this one.
# OMASIZER_SWAPPING marks the call that moves the other window: it never swaps
# itself, or the two would hand the swap back and forth forever.
if [[ $mode == zone && -n $layout && $swap_zones == true && -z ${OMASIZER_SWAPPING:-} ]]; then
  memories=$(jq -c 'if type == "object" then . else {} end' "$memory" 2>/dev/null) || memories='{}'
  others=$(hyprctl clients -j | jq -c --arg a "$address" --argjson ws "$(jq '.workspace.id // null' <<<"$client")" '
    map(select(.address != $a and .workspace.id == $ws and .floating and .fullscreen == 0 and .mapped != false and .hidden != true))') || others='[]'
  swap=$(jq -rn "${frame_args[@]}" --argjson zones "$layout" --argjson zone "[$zone_x, $zone_y, $zone_w, $zone_h]" \
    --argjson memories "${memories:-\{\}}" --argjson others "${others:-[]}" \
    --argjson window "$(jq -c '[.at[0], .at[1], .size[0], .size[1]]' <<<"$client")" "$geometry"'
    def fills($frame): [$frame, [.at[0], .at[1], .size[0], .size[1]]] | transpose | all(.[0] - .[1] | fabs <= 2);
    (first($zones[] | select([frame(.), $window] | transpose | all(.[0] - .[1] | fabs <= 2))) // null) as $from
    | select($from != null and ($from | map(. * 1e6 | round)) != ($zone | map(. * 1e6 | round)))
    | first($others[] | select($memories[.address] == $zones)
        | select(fills(frame($zone; if any(.tags[]?; . == "omarchy-floating-workspace" or . == "omarchy-floating-workspace*") then $bar_height else 0 end))))
    | "\(.address) \($from | map(tostring) | join(" "))"')
  if [[ -n $swap ]]; then
    read -r swap_address swap_zone <<<"$swap"
    OMASIZER_SWAPPING=1 "$0" --layout "$layout" --zone $swap_zone "$swap_address" || true
  fi
fi

if [[ $mode == zone ]]; then
  read -r x y width height < <(jq -rn "${frame_args[@]}" --argjson zone "[$zone_x, $zone_y, $zone_w, $zone_h]" \
    "$geometry"' frame($zone) | join(" ")')
elif [[ $clamp == true ]]; then
  # Oversized presets shrink to fit the screen, like KSizer's ClampToArea.
  (( width > area_w )) && width=$area_w
  (( height > area_h )) && height=$area_h
fi

hypr_dispatch() {
  local lua="$1"
  shift

  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null
}

# The window moved aside by a swap keeps out of focus, so a quick second keypress
# can't act on it; it is floating and not fullscreen, so nothing below needs focus.
[[ -n ${OMASIZER_SWAPPING:-} ]] || hypr_dispatch "hl.dsp.focus({ window = \"$window\" })" focuswindow "$window"

# Named and "unset", so if the window has gone meanwhile no other window is toggled instead.
case $fullscreen in
1) hypr_dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"unset\", window = \"$window\" })" fullscreen 1 ;;
2) hypr_dispatch "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"unset\", window = \"$window\" })" fullscreen 0 ;;
esac

[[ $floating == true ]] || hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"enable\" })" setfloating "$window"

hypr_dispatch "hl.dsp.window.resize({ window = \"$window\", x = $width, y = $height })" resizewindowpixel exact "$width" "$height,$window"
# Hyprland resizes a floating window around its middle, so keeping its place means moving it back.
if [[ $mode == size && $center == true ]]; then
  hypr_dispatch "hl.dsp.window.center({ window = \"$window\" })" centerwindow "$window"
else
  hypr_dispatch "hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })" movewindowpixel exact "$x" "$y,$window"
fi

# Remember the layout, keeping only windows that are still open. A preset size takes
# the window out of its layout, so it forgets it and the arrows start from the starred one.
if [[ -n $layout || $mode == size ]]; then
  open_windows=$(hyprctl clients -j | jq -c 'map(.address)') || open_windows='[]'
  { jq -c . "$memory" 2>/dev/null || echo '{}'; } | jq -c --arg a "$address" --argjson l "${layout:-null}" --argjson open "$open_windows" '
    (if type == "object" then . else {} end) | with_entries(select(.key as $k | $open | index($k)))
    | if $l == null then del(.[$a]) else . + {($a): $l} end' >"$memory.$$" \
    && mv "$memory.$$" "$memory"
fi
